# ==============================================================================
# Kalpak Solutions SaaS Platform - Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file into source control.
# ==============================================================================

# Application Environment (development | test | staging | production)
NODE_ENV=development
APP_NAME=kalpak-saas-platform
PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://kalpak_admin:kalpak_secure_pass@localhost:5432/kalpak_ticket_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (Cache, Sessions, Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session & Security
# Generate random 64-byte hex string in production: openssl rand -hex 64
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_characters_long
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=kalpak_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CSRF Protection
CSRF_SECRET=dev_csrf_secret_replace_in_production_min_32_characters_long

# MFA / 2-Step Authentication
MFA_APP_NAME="Kalpak Solutions"
MFA_BACKUP_CODES_COUNT=10

# Logging & Observability
LOG_LEVEL=debug
LOG_PRETTY=true

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URLs (In production on Render, set WEB_BASE_URL to frontend and API_BASE_URL to backend)
# WEB_BASE_URL=https://kalpak-web.onrender.com
# API_BASE_URL=https://kalpak-api.onrender.com

# ==============================================================================
# Outbound & Transactional Email Delivery (Invitations, Password Resets, Notifications)
# ==============================================================================
# Option 1: Standard SMTP (SendGrid, Mailgun SMTP, Brevo, AWS SES)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@yourdomain.com

# Option 2: Resend API Key (re_...)
# RESEND_API_KEY=re_1234567890abcdef

# Option 3: Gmail App Password (free for testing)
# GMAIL_USER=youraccount@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ==============================================================================
# Inbound Email Integration Configuration
# ==============================================================================
# Selected provider: mailgun | resend | postmark | sendgrid | generic | cloudmailin
EMAIL_PROVIDER=cloudmailin

# Provider API Key (optional for receiving webhooks, used for outbound verification/replies)
EMAIL_PROVIDER_API_KEY=

# Webhook Signing Secret:
# - Mailgun: HTTP Webhook Signing Key (from Mailgun Dashboard -> Sending -> Webhooks)
# - Resend: Webhook Signing Secret (starts with 'whsec_...')
# - Postmark: Secret token or basic auth password configured in Postmark
# - Generic: HMAC SHA-256 secret shared between webhook dispatcher and Kalpak
EMAIL_WEBHOOK_SECRET=dev_inbound_email_webhook_secret_key_2026

# Inbound email domain for routing (e.g. inbound.yourdomain.com or sandbox123.mailgun.org)
EMAIL_INBOUND_DOMAIN=inbound.kalpak.com

# Public Webhook Base URL:
# - Local development: HTTPS URL provided by ngrok tunnel (e.g. https://xxxx-xx-xx.ngrok-free.app)
# - Render deployment: Your Render backend HTTPS URL (e.g. https://kalpak-api.onrender.com)
EMAIL_WEBHOOK_BASE_URL=http://localhost:4000

# Google OAuth 2.0 Credentials (Free Tier / ₹0 - Gmail API)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://localhost:4000/api/v1/email-integration/gmail/oauth/callback (or Render URL)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/email-integration/gmail/oauth/callback

# CloudMailin Inbound Email Webhook Configuration (JSON - Normalized)
# Optional HTTP Basic Auth credentials entered in CloudMailin Address target URL
CLOUDMAILIN_USERNAME=
CLOUDMAILIN_PASSWORD=
# Optional secret token (verified via header x-cloudmailin-signature or ?secret=)
CLOUDMAILIN_SECRET=
# Default tenant slug fallback for CloudMailin test emails (e.g. apple, acme-corp)
CLOUDMAILIN_DEFAULT_TENANT_SLUG=apple


