# ==============================================================================
# Kalpak Solutions SaaS Platform - Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file into source control.
# ==============================================================================

# Application Environment (development | test | staging | production)
NODE_ENV=development
APP_NAME=kalpak-saas-platform
PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://kalpak_admin:kalpak_secure_pass@localhost:5432/kalpak_ticket_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (Cache, Sessions, Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session & Security
# Generate random 64-byte hex string in production: openssl rand -hex 64
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_characters_long
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=kalpak_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CSRF Protection
CSRF_SECRET=dev_csrf_secret_replace_in_production_min_32_characters_long

# MFA / 2-Step Authentication
MFA_APP_NAME="Kalpak Solutions"
MFA_BACKUP_CODES_COUNT=10

# Logging & Observability
LOG_LEVEL=debug
LOG_PRETTY=true

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
