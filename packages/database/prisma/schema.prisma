generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                          @db.VarChar(150)
  slug                    String                          @unique @db.VarChar(60)
  status                  TenantStatus                    @default(TRIAL)
  settings                Json                            @default("{}")
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                       @map("deleted_at") @db.Timestamptz(6)
  auditEvents             AuditEvent[]
  assets                  CustomerAsset[]
  customers               Customer[]
  departments             Department[]
  emailConfiguration      EmailConfiguration?
  emailConnection         EmailConnection?
  emailMessages           EmailMessage[]
  employees               EmployeeProfile[]
  inboundEmails           InboundEmail[]
  inventoryTransactions   InventoryTransaction[]
  invitations             Invitation[]
  notifications           Notification[]
  partInventory           PartInventory[]
  paymentTransactions     PaymentTransaction[]
  pmSchedules             PreventiveMaintenanceSchedule[]
  products                Product[]
  roles                   Role[]
  serviceCatalogs         ServiceCatalog[]
  serviceContracts        ServiceContract[]
  tickets                 ServiceTicket[]
  sessions                Session[]
  spareParts              SparePart[]
  storageLocations        StorageLocation[]
  subscriptions           Subscription[]
  supportEmails           SupportEmail[]
  memberships             TenantMembership[]
  policy                  TenantPolicy?
  ticketAssignments       TicketAssignment[]
  ticketPartConsumptions  TicketPartConsumption[]
  ticketTimeline          TicketTimeline[]
  workOrderChecklistItems WorkOrderChecklistItem[]
  workOrders              WorkOrder[]

  @@index([status], map: "idx_tenants_status")
  @@index([deletedAt], map: "idx_tenants_deleted_at")
  @@map("tenants")
}

model User {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                   @unique @db.VarChar(255)
  passwordHash          String                   @map("password_hash") @db.VarChar(255)
  fullName              String                   @map("full_name") @db.VarChar(150)
  phoneNumber           String?                  @map("phone_number") @db.VarChar(30)
  isActive              Boolean                  @default(true) @map("is_active")
  isSuperAdmin          Boolean                  @default(false) @map("is_super_admin")
  mfaEnabled            Boolean                  @default(false) @map("mfa_enabled")
  mfaSecret             String?                  @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes        String[]                 @default([]) @map("mfa_backup_codes")
  lastLoginAt           DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                @map("deleted_at") @db.Timestamptz(6)
  emailVerified         Boolean                  @default(false) @map("email_verified")
  emailVerifiedAt       DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  auditEvents           AuditEvent[]
  customerAccount       Customer?                @relation("CustomerUser")
  headedDepartments     Department[]             @relation("DepartmentHead")
  pocDepartments        Department[]             @relation("DepartmentPoc")
  verificationTokens    EmailVerificationToken[]
  employeeProfile       EmployeeProfile?
  inventoryTransactions InventoryTransaction[]   @relation("InventoryTransactionUser")
  sentInvitations       Invitation[]             @relation("InvitedByUser")
  notifications         Notification[]
  resetTokens           PasswordResetToken[]
  paymentTransactions   PaymentTransaction[]     @relation("UserPaymentTransactions")
  assignedTickets       ServiceTicket[]          @relation("TicketAssignedTo")
  closedTickets         ServiceTicket[]          @relation("TicketClosedBy")
  raisedTickets         ServiceTicket[]          @relation("TicketRaisedBy")
  sessions              Session[]
  bootstrapRecord       SystemBootstrap?         @relation("SuperAdminBootstrap")
  memberships           TenantMembership[]
  assignmentsGiven      TicketAssignment[]       @relation("AssignmentActor")
  assignmentsReceived   TicketAssignment[]       @relation("AssignmentTarget")
  partsConsumed         TicketPartConsumption[]  @relation("PartConsumedByUser")
  ticketTimelineEvents  TicketTimeline[]         @relation("TimelineActor")
  assignedWorkOrders    WorkOrder[]              @relation("WorkOrderTechnician")

  @@index([email], map: "idx_users_email")
  @@index([isActive], map: "idx_users_is_active")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model TenantMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  role      Role     @relation(fields: [roleId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId], name: "uq_membership_tenant_user")
  @@index([tenantId], map: "idx_memberships_tenant_id")
  @@index([userId], map: "idx_memberships_user_id")
  @@map("tenant_memberships")
}

model Role {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?            @map("tenant_id") @db.Uuid
  name        String             @db.VarChar(80)
  description String?            @db.VarChar(255)
  isSystem    Boolean            @default(false) @map("is_system")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitations Invitation[]
  permissions RolePermission[]
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]

  @@unique([tenantId, name], name: "uq_roles_tenant_name")
  @@index([tenantId], map: "idx_roles_tenant_id")
  @@map("roles")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String    @db.VarChar(255)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_email_tokens_hash")
  @@index([userId], map: "idx_email_tokens_user_id")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_reset_tokens_hash")
  @@index([userId], map: "idx_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

model Invitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @db.VarChar(255)
  roleId          String    @map("role_id") @db.Uuid
  department      String?   @db.VarChar(100)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  fullName        String?   @map("full_name") @db.VarChar(150)
  phone           String?   @map("phone") @db.VarChar(30)
  invitedBy       User?     @relation("InvitedByUser", fields: [invitedByUserId], references: [id])
  role            Role      @relation(fields: [roleId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_invitations_token_hash")
  @@index([tenantId], map: "idx_invitations_tenant_id")
  @@index([email], map: "idx_invitations_email")
  @@map("invitations")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(80)
  description String           @db.VarChar(255)
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@index([module], map: "idx_permissions_module")
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  activeTenantId   String?   @map("active_tenant_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(64)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  mfaVerified      Boolean   @default(false) @map("mfa_verified")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  activeTenant     Tenant?   @relation(fields: [activeTenantId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([activeTenantId], map: "idx_sessions_active_tenant_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([revokedAt], map: "idx_sessions_revoked_at")
  @@map("sessions")
}

model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(80)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  action       String   @db.VarChar(80)
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation(fields: [actorId], references: [id])
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_audit_events_tenant_id")
  @@index([actorId], map: "idx_audit_events_actor_id")
  @@index([eventType], map: "idx_audit_events_event_type")
  @@index([createdAt], map: "idx_audit_events_created_at")
  @@map("audit_events")
}

model TenantPolicy {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String              @unique @map("tenant_id") @db.Uuid
  businessType          BusinessType        @default(BOTH) @map("business_type")
  purposeOfUse          PurposeOfUse        @default(BOTH) @map("purpose_of_use")
  allowCustomerToRaise  Boolean             @default(true) @map("allow_customer_to_raise")
  allowEmployeeOnBehalf Boolean             @default(true) @map("allow_employee_on_behalf")
  assignmentStrategy    AssignmentStrategy  @default(MANUAL_DEPT_HEAD) @map("assignment_strategy")
  closureAuthority      ClosureAuthority    @default(SUPPORT_EMPLOYEE) @map("closure_authority")
  tolerableOpenDays     Int                 @default(3) @map("tolerable_open_days")
  notificationChannels  NotificationChannel @default(EMAIL) @map("notification_channels")
  platformAccess        PlatformAccess      @default(BOTH) @map("platform_access")
  pushNotifications     Boolean             @default(true) @map("push_notifications")
  maxUsersQuota         Int                 @default(25) @map("max_users_quota")
  subscriptionStartsAt  DateTime            @default(now()) @map("subscription_starts_at") @db.Timestamptz(6)
  subscriptionEndsAt    DateTime?           @map("subscription_ends_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_policies")
}

model Department {
  id                String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                          @map("tenant_id") @db.Uuid
  name              String                          @db.VarChar(100)
  code              String                          @db.VarChar(50)
  description       String?
  headUserId        String?                         @map("head_user_id") @db.Uuid
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?                       @map("deleted_at") @db.Timestamptz(6)
  isActive          Boolean                         @default(true) @map("is_active")
  pocName           String?                         @map("poc_name") @db.VarChar(100)
  pocEmail          String?                         @map("poc_email") @db.VarChar(255)
  pocPhone          String?                         @map("poc_phone") @db.VarChar(30)
  pocUserId         String?                         @map("poc_user_id") @db.Uuid
  headUser          User?                           @relation("DepartmentHead", fields: [headUserId], references: [id])
  pocUser           User?                           @relation("DepartmentPoc", fields: [pocUserId], references: [id])
  tenant            Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeProfiles  EmployeeProfile[]
  pmSchedules       PreventiveMaintenanceSchedule[]
  products          Product[]
  tickets           ServiceTicket[]
  ticketAssignments TicketAssignment[]

  @@unique([tenantId, code], name: "uq_department_tenant_code")
  @@index([tenantId], map: "idx_departments_tenant_id")
  @@index([deletedAt], map: "idx_departments_deleted_at")
  @@map("departments")
}

model Customer {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  companyName         String            @map("company_name") @db.VarChar(150)
  contactPerson       String            @map("contact_person") @db.VarChar(100)
  email               String            @db.VarChar(255)
  phone               String            @db.VarChar(30)
  address             String?
  city                String?           @db.VarChar(100)
  pincode             String?           @db.VarChar(20)
  status              String            @default("ACTIVE") @db.VarChar(30)
  portalAccessEnabled Boolean           @default(false) @map("portal_access_enabled")
  userId              String?           @unique @map("user_id") @db.Uuid
  notes               String?
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(6)
  assets              CustomerAsset[]
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?             @relation("CustomerUser", fields: [userId], references: [id])
  serviceContracts    ServiceContract[]
  tickets             ServiceTicket[]
  workOrders          WorkOrder[]

  @@index([tenantId], map: "idx_customers_tenant_id")
  @@index([email], map: "idx_customers_email")
  @@index([phone], map: "idx_customers_phone")
  @@index([status], map: "idx_customers_status")
  @@index([deletedAt], map: "idx_customers_deleted_at")
  @@map("customers")
}

model Product {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  departmentId         String?         @map("department_id") @db.Uuid
  name                 String          @db.VarChar(150)
  modelNumber          String          @map("model_number") @db.VarChar(100)
  category             String          @db.VarChar(80)
  description          String?
  hasWarranty          Boolean         @default(true) @map("has_warranty")
  warrantyPeriodMonths Int             @default(12) @map("warranty_period_months")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz(6)
  assets               CustomerAsset[]
  department           Department?     @relation(fields: [departmentId], references: [id])
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets              ServiceTicket[]

  @@unique([tenantId, modelNumber], name: "uq_product_tenant_model")
  @@index([tenantId], map: "idx_products_tenant_id")
  @@index([category], map: "idx_products_category")
  @@index([deletedAt], map: "idx_products_deleted_at")
  @@map("products")
}

model ServiceCatalog {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  name        String          @db.VarChar(150)
  code        String          @db.VarChar(50)
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets     ServiceTicket[]

  @@unique([tenantId, code], name: "uq_service_catalog_tenant_code")
  @@index([tenantId], map: "idx_service_catalog_tenant_id")
  @@index([deletedAt], map: "idx_service_catalog_deleted_at")
  @@map("service_catalogs")
}

model CustomerAsset {
  id                String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                          @map("tenant_id") @db.Uuid
  customerId        String                          @map("customer_id") @db.Uuid
  productId         String                          @map("product_id") @db.Uuid
  serialNumber      String                          @map("serial_number") @db.VarChar(100)
  installationDate  DateTime?                       @map("installation_date") @db.Timestamptz(6)
  warrantyEndDate   DateTime?                       @map("warranty_end_date") @db.Timestamptz(6)
  location          String?                         @db.VarChar(150)
  status            String                          @default("OPERATIONAL") @db.VarChar(30)
  notes             String?
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?                       @map("deleted_at") @db.Timestamptz(6)
  contractCoverages ContractAsset[]
  customer          Customer                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product           Product                         @relation(fields: [productId], references: [id])
  tenant            Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pmSchedules       PreventiveMaintenanceSchedule[]
  tickets           ServiceTicket[]
  workOrders        WorkOrder[]

  @@unique([tenantId, serialNumber], name: "uq_asset_tenant_serial")
  @@index([tenantId], map: "idx_assets_tenant_id")
  @@index([customerId], map: "idx_assets_customer_id")
  @@index([productId], map: "idx_assets_product_id")
  @@index([status], map: "idx_assets_status")
  @@index([deletedAt], map: "idx_assets_deleted_at")
  @@map("customer_assets")
}

model EmployeeProfile {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  userId             String      @unique @map("user_id") @db.Uuid
  departmentId       String?     @map("department_id") @db.Uuid
  designation        String?     @db.VarChar(100)
  skills             String[]    @default([])
  phone              String?     @db.VarChar(30)
  isAvailable        Boolean     @default(true) @map("is_available")
  activeTicketsCount Int         @default(0) @map("active_tickets_count")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  department         Department? @relation(fields: [departmentId], references: [id])
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_employees_tenant_id")
  @@index([departmentId], map: "idx_employees_department_id")
  @@index([isAvailable], map: "idx_employees_is_available")
  @@map("employee_profiles")
}

model ServiceTicket {
  id                  String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                         @map("tenant_id") @db.Uuid
  ticketNumber        String                         @map("ticket_number") @db.VarChar(30)
  title               String                         @db.VarChar(250)
  description         String
  status              TicketStatus                   @default(OPEN)
  priority            TicketPriority                 @default(MEDIUM)
  raisedBy            TicketRaisedBy                 @default(EMPLOYEE) @map("raised_by")
  raisedByUserId      String?                        @map("raised_by_user_id") @db.Uuid
  raisedForCustomerId String?                        @map("raised_for_customer_id") @db.Uuid
  assignedToUserId    String?                        @map("assigned_to_user_id") @db.Uuid
  departmentId        String?                        @map("department_id") @db.Uuid
  customerAssetId     String?                        @map("customer_asset_id") @db.Uuid
  isOverdue           Boolean                        @default(false) @map("is_overdue")
  tolerableOpenDays   Int                            @default(5) @map("tolerable_open_days")
  dueAt               DateTime?                      @map("due_at") @db.Timestamptz(6)
  resolvedAt          DateTime?                      @map("resolved_at") @db.Timestamptz(6)
  closedAt            DateTime?                      @map("closed_at") @db.Timestamptz(6)
  createdAt           DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
