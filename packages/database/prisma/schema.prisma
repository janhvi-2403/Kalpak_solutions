  @@index([tenantId], map: "idx_payments_tenant_id")
  @@index([userId], map: "idx_payments_user_id")
  @@index([status], map: "idx_payments_status")
  @@index([orderId], map: "idx_payments_order_id")
  @@map("payment_transactions")
}

